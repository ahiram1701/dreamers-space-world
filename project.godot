; Engine configuration file.
; Godot 4.x

config_version=5

[application]

config/name="Dreamer's Space World"
config/description="Un multiverso que crece contigo: la IA genera el mundo según tus decisiones."
config/version="0.2.1"
run/main_scene="res://scenes/main_menu/MainMenu.tscn"
config/features=PackedStringArray("4.7")

[autoload]

Settings="*res://autoload/Settings.gd"
AIClient="*res://autoload/AIClient.gd"
ContentValidator="*res://autoload/ContentValidator.gd"
WorldDB="*res://autoload/WorldDB.gd"
ContentGenerator="*res://autoload/ContentGenerator.gd"
NPCMemory="*res://autoload/NPCMemory.gd"
PlayerProfile="*res://autoload/PlayerProfile.gd"
StoryDirector="*res://autoload/StoryDirector.gd"
Updater="*res://autoload/Updater.gd"
GameState="*res://autoload/GameState.gd"
TimelineManager="*res://autoload/TimelineManager.gd"
Travel="*res://autoload/Travel.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/mode=2
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
